# Optional: docker compose host-port overrides (copy to `.env` only if needed).
#
# The compose file defaults to the ports documented in the README
# (API 4000, web 3000), so most machines need nothing here. Use this file only
# when a host port is already taken or reserved by the OS - for example Windows
# Hyper-V/WinNAT reserves TCP 3998-4097 on some machines, which makes 4000
# unbindable. Run `netsh interface ipv4 show excludedportrange protocol=tcp` to
# check.
#
# If you change API_HOST_PORT, also point NEXT_PUBLIC_API_URL in
# `frontend/.env` at the same port, because the browser reaches the API
# directly.

API_HOST_PORT=4000
WEB_HOST_PORT=3000
